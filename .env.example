# Bu faylni .env nomiga ko'chiring: copy .env.example .env  (Linux: cp .env.example .env)
SITE_NAME=Online kutubxona
ADMIN_USER=admin
# Kamida 10 belgi, "admin123" kabi oson parol bo'lmasin
ADMIN_PASSWORD=BU_YERGA_KUCHLI_PAROL
# Bo'sh qoldirsangiz, server o'zi data/secret.key yaratadi (yaxshi). Faqat bir nechta server bo'lsa kerak.
# SECRET_KEY=
MAX_PDF_MB=100
# Serverda: production (kuchsiz parol bo'lsa server ishga tushmaydi)
APP_ENV=development
# Domen (faqat docker compose + Caddy uchun): kutubxona.uz
DOMAIN=localhost
